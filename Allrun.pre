#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# copy tutorial surfaces (cylinders) from resources directory
cp -rf \
    "$FOAM_TUTORIALS"/resources/geometry/propeller \
    constant/triSurface

# copy my rotor geometry (scaled to metres)
cp -f ~/OpenFOAM/geometry/rotor_shift.stl constant/triSurface/

runApplication blockMesh

runApplication surfaceFeatureExtract

runApplication snappyHexMesh -overwrite

runApplication renumberMesh -overwrite

# force removal of fields generated by snappy
rm -rf 0

# inlet/outlet/farfield now come straight from blockMesh
# (topoSet split of outerCylinder no longer needed)

# No AMI: the whole mesh rotates as a solid body (constant/dynamicMeshDict),
# so createPatch is no longer needed.

# cellZone 'rotatingFrame' containing every cell (for dynamicMeshDict)
runApplication topoSet


#------------------------------------------------------------------------------
