FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// cellZone 'rotatingFrame' = every cell of the mesh (used by MRFProperties).

actions
(
    {
        name    rotatingFrameSet;
        type    cellSet;
        action  new;
        source  boxToCell;
        box     (-100 -100 -100) (100 100 100);
    }
    {
        name    rotatingFrame;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        set     rotatingFrameSet;
    }
);


